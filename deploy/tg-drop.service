[Unit]
Description=tg-drop
Wants=network-online.target
After=network-online.target

[Service]
User=tg-drop
Group=tg-drop
WorkingDirectory=/srv/tg-drop/app
Environment=NODE_ENV=production
EnvironmentFile=/etc/tg-drop.env
ExecStart=node dist/server/server/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=2min
KillMode=mixed

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/tg-drop/data
MemoryMax=512M

[Install]
WantedBy=multi-user.target
