{
  "name": "tg-drop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k 'tsx watch --env-file-if-exists=.env server/index.ts' 'vite --host 127.0.0.1'",
    "build": "vite build && tsup server/index.ts scripts/telegram-login.ts --format esm --out-dir dist/server --clean --splitting",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "telegram:login": "tsx --env-file=.env scripts/telegram-login.ts",
    "setup": "tsx scripts/setup.ts"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@mtcute/node": "^0.32.7",
    "@uppy/core": "^6.3.1",
    "@uppy/xhr-upload": "^6.0.1",
    "@zip.js/zip.js": "^2.24.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "p-queue": "^10.0.0",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
